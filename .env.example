# Postgres owner and role bootstrap
POSTGRES_USER=concierge
POSTGRES_PASSWORD=concierge
POSTGRES_DB=concierge
CONCIERGE_APP_PASSWORD=concierge_app
CONCIERGE_MANAGER_PASSWORD=concierge_manager

# Host-local DSNs used by Makefile, tests, and Alembic
MIGRATION_DATABASE_URL=postgresql+asyncpg://concierge:concierge@localhost:5432/concierge
DATABASE_URL=postgresql+asyncpg://concierge_app:concierge_app@localhost:5432/concierge
MANAGER_DATABASE_URL=postgresql+asyncpg://concierge_manager:concierge_manager@localhost:5432/concierge

# Redis, MinIO, Vault
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
# MinIO server bootstrap credentials (used by the minio container itself)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# MinIO client credentials read by the API (Settings.minio_access_key / minio_secret_key)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=concierge
VAULT_ADDR=http://localhost:8200
VAULT_DEV_ROOT_TOKEN_ID=dev-root-token
VAULT_KV_MOUNT=secret

# API/session bootstrap
SESSION_SECRET=change-me-in-prod
PUBLIC_BASE_URL=http://localhost:8000
BOOTSTRAP_MANAGER_EMAIL=
BOOTSTRAP_MANAGER_PASSWORD=
DEMO_ADMIN_PASSWORD=

# Owner B/C/D provider placeholders
ANTHROPIC_API_KEY=
# LLM_MODEL — read by Settings.llm_model. Use claude-haiku-4-5-20251001 for demo/dev.
LLM_MODEL=claude-haiku-4-5-20251001
GROQ_API_KEY=
# Embedding: set EMBEDDING_PROVIDER=voyage (or voyage-4-lite) and EMBEDDING_API_KEY.
# EMBEDDING_MODEL overrides the per-provider default (voyage-3 is the default for voyage).
# Do NOT use voyage-3s — it is not a valid Voyage model name.
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3
EMBEDDING_API_KEY=
RERANK_PROVIDER=rerank-2.5-lite
RERANK_API_KEY=
CLASSIFIER_URL=http://localhost:8001
GUARDRAILS_URL=http://localhost:8002
SERVICE_TOKEN=
